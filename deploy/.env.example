APP_DOMAIN=reviews.example.ru

APP_NAME="Yandex Reviews"
APP_ENV=production
APP_KEY=base64:ЗАМЕНИТЬ_КОМАНДОЙ_ИЗ_ИНСТРУКЦИИ
APP_DEBUG=false
APP_URL=https://reviews.example.ru
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yandex_reviews
DB_USERNAME=yandex_reviews
DB_PASSWORD=ЗАМЕНИТЬ_НАДЕЖНЫМ_ПАРОЛЕМ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=reviews.example.ru
CORS_ALLOWED_ORIGINS=https://reviews.example.ru

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=2100
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Yandex Reviews"

DEMO_USER_NAME="Demo User"
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=ЗАМЕНИТЬ_НАДЕЖНЫМ_ПАРОЛЕМ

YANDEX_MAPS_CONNECT_TIMEOUT=5
YANDEX_MAPS_TIMEOUT=20
YANDEX_MAPS_RETRIES=2
YANDEX_MAPS_RETRY_DELAY_MS=500
YANDEX_MAPS_MAX_PAGES=100
YANDEX_MAPS_MAX_REVIEWS=600
YANDEX_MAPS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/140 Safari/537.36"
